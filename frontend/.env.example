# Frontend environment template
#
# Copy this file to frontend/.env for local development.
# Never commit real keys or tokens, even when the repository is private.

# Supabase 配置
# 从 Supabase Dashboard > Settings > API 获取
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# API 地址
# 本地开发默认 http://localhost:5001/api
# Vercel 海外生产建议：https://dog-project-6aoq.vercel.app/api
# CloudBase 大陆生产建议：https://<cloudbase-run-domain>/api
VITE_API_URL=

# 大陆构建建议设为 true，避免浏览器端直连 Supabase Auth
VITE_DISABLE_SUPABASE_CLIENT_AUTH=false

# RN 试点开关（true 时在宠物详情页展示 Deep Link 入口）
VITE_ENABLE_RN_PET_DETAILS=false
