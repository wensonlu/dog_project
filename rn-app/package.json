{
  "name": "rn-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "bundle:ios": "node ../scripts/rn-bundle-manifest.mjs",
    "bundle:qr": "node ../scripts/rn-bundle-manifest.mjs --serve",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-constants": "~17.0.0",
    "expo-linking": "~7.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.7"
  },
  "private": true,
  "devDependencies": {
    "@react-native-community/cli": "^15.0.0",
    "@react-native/metro-config": "^0.76.0"
  }
}
