# Backend environment template
#
# Copy this file to backend/.env for local development.
# Never commit real keys or model tokens, even when the repository is private.

# Runtime
# NODE_ENV=development
# DEBUG=true
# PORT=5001

# Supabase（必填，本地开发与部署环境均需配置）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# 可选：使用 anon key 时需配合前端传 JWT，且受 RLS 限制
# SUPABASE_ANON_KEY=your_anon_key
# 兼容旧配置名；新环境优先使用 SUPABASE_ANON_KEY
# SUPABASE_KEY=your_anon_key

# AI 配置（聊天与内容生成）
# 支持企业网关（如 ADA）或官方 Anthropic 兼容地址
AI_ENABLED=false
AI_BASE_URL=https://your-ai-api-endpoint
AI_API_KEY=your_ai_api_key
AI_MODEL=your_supported_model_name

# 兼容旧模型服务配置名；当前后端运行时优先读取 AI_API_KEY
# ANTHROPIC_API_KEY=your_anthropic_api_key
