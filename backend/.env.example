# Supabase（必填，本地开发与 Vercel 部署均需配置）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# 可选：使用 anon key 时需配合前端传 JWT，且受 RLS 限制
# SUPABASE_ANON_KEY=your_anon_key

# 可选：本地端口，默认 5001；CloudBase Run 会自动注入 PORT
# PORT=5001

# AI 配置（聊天与内容生成）
# 支持企业网关（如 ADA）或官方 Anthropic 兼容地址
AI_ENABLED=false
AI_BASE_URL=https://your-ai-api-endpoint
AI_API_KEY=your_ai_api_key
AI_MODEL=your_supported_model_name
